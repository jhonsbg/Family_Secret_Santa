# URL directa de una base de desarrollo llamada Family_Secret_Santa.
# Copia este archivo a .env.local y sustituye el valor vacío.
DATABASE_URL_DEV=

# Origen exacto del formulario, sin barra final.
AUTH_ORIGIN=http://localhost:3000
# Genera un valor de 32 bytes aleatorios en base64url y guárdalo solo en el servidor.
AUTH_PEPPER=
# Conexión agrupada de Neon para el tráfico web. En desarrollo puede omitirse.
DATABASE_URL_AUTH=

# Días de conservación tras vencer un contador y tras registrar un evento de recuperación.
AUTH_ATTEMPTS_RETENTION_DAYS=7
AUTH_EVENTS_RETENTION_DAYS=90

# Base local desechable usada por las pruebas de integración.
DATABASE_URL_TEST=

# Vercel Preview y Production. Guarda cada URL solo en su entorno.
DATABASE_URL_AUTH_PREVIEW=
DATABASE_URL_AUTH_PRODUCTION=
# Solo estación de mantenimiento. Conexiones directas, fuera del runtime web.
DATABASE_URL_MIGRATION_PREVIEW=
DATABASE_URL_MIGRATION_PRODUCTION=
